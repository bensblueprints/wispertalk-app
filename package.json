{
  "name": "wispertalk",
  "version": "1.2.0",
  "description": "WisperTalk — voice dictation. $49.99 lifetime.",
  "main": "src/main/main.js",
  "author": {
    "name": "Ben",
    "email": "ben@advancedmarketing.co"
  },
  "license": "MIT",
  "scripts": {
    "start": "electron .",
    "dev": "electron . --dev",
    "icon": "node scripts/make-icon.js",
    "models": "node scripts/fetch-models.js",
    "pack": "npm run icon && npm run models && electron-builder --dir",
    "dist": "npm run icon && npm run models && electron-builder --win",
    "dist:mac": "npm run models && electron-builder --mac --arm64 --x64",
    "postinstall": "electron-builder install-app-deps"
  },
  "dependencies": {
    "@huggingface/transformers": "^4.2.0",
    "uiohook-napi": "^1.5.4"
  },
  "devDependencies": {
    "electron": "^33.2.0",
    "electron-builder": "^25.1.8",
    "png-to-ico": "^2.1.8"
  },
  "build": {
    "appId": "com.wispertalk.app",
    "productName": "WisperTalk",
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "src/**/*",
      "assets/**/*",
      "models/**/*",
      "package.json",
      "!node_modules/onnxruntime-web${/*}"
    ],
    "asarUnpack": [
      "node_modules/uiohook-napi/**/*",
      "node_modules/onnxruntime-node/**/*",
      "models/**/*"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.ico",
      "publisherName": "Advanced Marketing",
      "files": [
        "!node_modules/onnxruntime-node/bin/napi-v6/darwin${/*}",
        "!node_modules/onnxruntime-node/bin/napi-v6/linux${/*}",
        "!node_modules/onnxruntime-node/bin/napi-v6/win32/arm64${/*}",
        "!node_modules/onnxruntime-node/bin/napi-v6/win32/x64/DirectML.dll",
        "!node_modules/onnxruntime-node/bin/napi-v6/win32/x64/dxcompiler.dll",
        "!node_modules/onnxruntime-node/bin/napi-v6/win32/x64/dxil.dll"
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "WisperTalk"
    },
    "portable": {
      "artifactName": "WisperTalk-${version}-portable.exe"
    },
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64",
            "x64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "arm64",
            "x64"
          ]
        }
      ],
      "category": "public.app-category.productivity",
      "files": [
        "!node_modules/onnxruntime-node/bin/napi-v6/win32${/*}",
        "!node_modules/onnxruntime-node/bin/napi-v6/linux${/*}"
      ],
      "icon": "build/icon.png",
      "identity": null,
      "gatekeeperAssess": false,
      "hardenedRuntime": false,
      "extendInfo": {
        "NSMicrophoneUsageDescription": "WisperTalk needs microphone access to transcribe your speech.",
        "NSAppleEventsUsageDescription": "WisperTalk uses AppleScript to paste transcribed text into the focused application."
      }
    },
    "dmg": {
      "sign": false,
      "writeUpdateInfo": false
    }
  }
}
